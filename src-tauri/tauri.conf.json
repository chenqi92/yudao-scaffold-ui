{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yudao-scaffold",
  "version": "0.1.4",
  "identifier": "cn.iocoder.yudao.scaffold",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "yudao-scaffold",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Scaffold yudao-based Spring Boot / Cloud projects",
    "longDescription": "Interactive desktop generator for yudao monolith and microservice projects. Picks modules, frontends, prunes templates, renames packages, and writes a ready-to-build project.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEMUYyMDUxNjk1NjFDRTUKUldUbEhGWnBVU0FmUGRNV0hWbEJQWDJudXlHVWo3VXJTemhZK3Y0eklCdGdiU0o0WCs2SnJ6eGMK",
      "endpoints": [
        "https://github.com/chenqi92/yudao-scaffold-ui/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
